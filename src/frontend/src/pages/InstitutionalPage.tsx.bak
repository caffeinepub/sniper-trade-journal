const ARCHIVE_THRESHOLD_DAYS = 14;

function isArchived(dateStr: string): boolean {
  const date = new Date(dateStr);
  const now = new Date();
  return now.getTime() - date.getTime() > ARCHIVE_THRESHOLD_DAYS * 86400000;
}

