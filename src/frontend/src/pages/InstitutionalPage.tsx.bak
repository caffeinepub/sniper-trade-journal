// Category helpers
function getMarketCategory(
  market: string,
): "currency" | "commodity" | "crypto" | "macro" {
  if (CURRENCIES.includes(market)) return "currency";
  if (COMMODITIES.includes(market)) return "commodity";
  if (CRYPTO.includes(market)) return "crypto";
  return "macro";
}

